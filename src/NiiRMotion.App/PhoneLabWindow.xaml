<Window x:Class="NiiRMotion.App.PhoneLabWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Telefon Laboratuvarı" Width="820" Height="590" WindowStartupLocation="CenterOwner" Background="#050A12" Foreground="#F6F9FF" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F6F9FF"/></Style><Style TargetType="Button"><Setter Property="Foreground" Value="#F6F9FF"/><Setter Property="Background" Value="#0D1928"/><Setter Property="BorderBrush" Value="#2A3B54"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="ComboBox"><Setter Property="Foreground" Value="#101722"/><Setter Property="Padding" Value="10,8"/></Style></Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Telefon Laboratuvarı" FontSize="24" FontWeight="Bold"/><TextBlock Text="Yalnız owoTrack verisi · VR çıkışı kapalı" Foreground="#75A6FF" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#102443" CornerRadius="5" Padding="12,7"><TextBlock x:Name="ConnectionText" Text="BAĞLANTI BEKLİYOR" Foreground="#F6C86B" FontWeight="Bold"/></Border></Grid>
  <Grid Grid.Row="1" Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><Border Background="#080F19" BorderBrush="#233044" BorderThickness="1" CornerRadius="6" Padding="18"><StackPanel><TextBlock Text="TELEFON YERLEŞİMİ" Foreground="#75A6FF" FontWeight="Bold" FontSize="11"/><TextBlock Text="YATAY" FontSize="28" FontWeight="Bold" Margin="0,14,0,0"/><TextBlock Text="Ekran göğsüne dönük" FontSize="18" Foreground="#72E1C2"/><TextBlock Text="Göğsün ortasında · telefonun üst kenarı sola bakacak · sallanmayacak kadar sabit" Foreground="#AFC0D8" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><Border Background="#080F19" BorderBrush="#233044" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HAREKET" Foreground="#75A6FF" FontSize="10"/><TextBlock x:Name="GyroValue" Text="0.00" FontSize="27"/><TextBlock Text="rad/sn" Foreground="#8FA4BF"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="İVME" Foreground="#75A6FF" FontSize="10"/><TextBlock x:Name="AccelValue" Text="0.00" FontSize="27"/><TextBlock Text="m/sn²" Foreground="#8FA4BF"/></StackPanel></Grid></Border></StackPanel>
   <StackPanel Grid.Column="2"><Border Background="#080F19" BorderBrush="#233044" BorderThickness="1" CornerRadius="6" Padding="18"><StackPanel><TextBlock Text="KAYIT TÜRÜ" Foreground="#75A6FF" FontWeight="Bold" FontSize="11"/><ComboBox x:Name="LabelSelector" SelectedIndex="2" Margin="0,10"><ComboBoxItem Tag="stand">Ayakta sabit</ComboBoxItem><ComboBoxItem Tag="slow">Yavaş yürüyüş</ComboBoxItem><ComboBoxItem Tag="natural">Doğal yürüyüş</ComboBoxItem><ComboBoxItem Tag="fast">Hızlı yürüyüş</ComboBoxItem><ComboBoxItem Tag="stop">Yürü ve dur</ComboBoxItem></ComboBox><Border Background="#101E31" CornerRadius="5" Padding="16" Margin="0,5"><StackPanel><TextBlock x:Name="InstructionText" Text="Önce telefonu bağla" Foreground="#72E1C2" FontSize="19" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="CounterText" FontSize="38" FontWeight="Bold" TextAlignment="Center"/></StackPanel></Border><Button x:Name="RecordButton" Content="●  KAYDI BAŞLAT" Background="#2F6CDF" IsEnabled="False" Click="RecordClick"/><TextBlock x:Name="RecordInfo" Text="Kayıt başlamadı." Foreground="#91A5C0" TextWrapping="Wrap" Margin="4,8"/></StackPanel></Border></StackPanel>
  </Grid>
  <Grid Grid.Row="2"><TextBlock x:Name="StatusText" Text="owoTrack'i başlat; sonra Bağlan'a bas." Foreground="#AFC0D8" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="ConnectButton" Content="TELEFONA BAĞLAN" Click="ConnectClick"/><Button Content="KAPAT" Click="CloseClick"/></StackPanel></Grid>
 </Grid>
</Window>
