<Window x:Class="NiiRMotion.App.AdvancedTrainingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Model Geliştirme" Width="760" Height="520" WindowStartupLocation="CenterOwner" Background="#070D13" Foreground="#F4F7FA" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F7FA"/></Style><Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#101A24"/><Setter Property="BorderBrush" Value="#2B4050"/><Setter Property="Padding" Value="16,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Modeli yeni kayıtlarla geliştir" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ProfileText" Foreground="#62CFF6" FontSize="12" Margin="0,6,0,0"/></StackPanel>
  <Border Grid.Row="1" Margin="0,24,0,20" Padding="24" Background="#0D151D" BorderBrush="#273945" BorderThickness="1" CornerRadius="9"><StackPanel>
   <TextBlock Text="SEÇİLİ SENSÖR KOMBİNASYONU" Foreground="#35B8F5" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="SensorText" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Bu kayıt temel kalibrasyonu değiştirmez. Sensörlerin birlikte çalışmasını güçlendiren yeni bir eğitim örneği ekler." Foreground="#94A1AD" TextWrapping="Wrap"/>
   <Border Margin="0,22,0,18" Padding="16" Background="#09131C" CornerRadius="7"><StackPanel><TextBlock x:Name="InstructionText" Text="5 dakika boyunca yavaş, doğal ve hızlı yerinde yürüyüş; kısa duruş, dönüş ve eğilme hareketleri yap." TextWrapping="Wrap" FontSize="14"/><TextBlock x:Name="TimerText" Text="00:00 / 05:00" HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold" Margin="0,18,0,8"/><ProgressBar x:Name="Progress" Maximum="300" Height="7" Foreground="#35B8F5" Background="#1A2B37"/></StackPanel></Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="▶  5 DK KOMBİNE KAYDI BAŞLAT" Background="#147DBA" Click="StartClick"/><Button x:Name="RejectButton" Grid.Column="2" Content="↶  SON KAYDI REDDET" IsEnabled="False" Click="RejectClick"/></Grid>
  </StackPanel></Border>
  <Grid Grid.Row="2"><TextBlock Text="VR çıkışı kapalıdır · kayıt yalnız kişisel modeli geliştirmek için kullanılır" Foreground="#8294A1" VerticalAlignment="Center"/><Button Content="KAPAT" HorizontalAlignment="Right" Click="CloseClick"/></Grid>
 </Grid>
</Window>
