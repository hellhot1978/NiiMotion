<Window x:Class="NiiRMotion.App.RecoveryCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Yedekleme Merkezi" Icon="/NiiRMotion.App;component/Assets/niirmotion.ico" Width="720" Height="560" WindowStartupLocation="CenterOwner" Background="#060A0F" Foreground="#F4F7FA" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable" ResizeMode="NoResize">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Yedekleme ve geri yükleme" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Kişisel modeller, cihaz tercihleri ve oyun ayarları · ham sensör kayıtları kopyalanmaz" Foreground="#8FA1AD" Margin="0,5,0,18"/></StackPanel>
  <ListBox x:Name="Snapshots" Grid.Row="1" Background="#0B141D" BorderBrush="#2B4050" Foreground="White" Padding="8" DisplayMemberPath="Display"/>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Geri yüklemeden önce mevcut durum otomatik yedeklenir." Foreground="#72E1C2" VerticalAlignment="Center"/><Button Grid.Column="1" Content="YENİ YEDEK" Padding="18,10" Click="CreateClick"/><Button Grid.Column="3" Content="SEÇİLİ YEDEĞİ GERİ YÜKLE" Padding="18,10" Click="RestoreClick"/><Button Grid.Column="5" Content="KAPAT" Padding="18,10" Click="CloseClick"/></Grid>
  <Border Grid.Row="3" Background="#211319" BorderBrush="#61303D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ÖĞRENİLMİŞ HAREKET VERİSİ" Foreground="#FF95A8" FontSize="10" FontWeight="Bold"/><TextBlock Text="Cihaz eşleştirmeleri, oyun ayarları ve uygulama korunur. Önce geri dönüş ZIP'i oluşturulur." Foreground="#AFA0A5" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="GÜVENLİ SIFIRLA" Background="#351821" BorderBrush="#7B3547" Padding="16,9" Click="ResetLearnedDataClick"/></Grid></Border>
 </Grid>
</Window>
