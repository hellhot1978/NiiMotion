<Window x:Class="NiiRMotion.App.HardwareSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Cihazlarım" Icon="/NiiRMotion.App;component/Assets/niirmotion.ico" Width="920" Height="650" WindowStartupLocation="CenterOwner" Background="#060A0F" Foreground="#F4F7FA" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable" ResizeMode="NoResize">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F7FA"/></Style>
  <Style x:Key="DeviceChoice" TargetType="CheckBox"><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Card" Width="250" Height="150" Background="#0E151D" BorderBrush="#293945" BorderThickness="1" CornerRadius="9" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ContentPresenter/><Grid Grid.Row="1" Margin="0,8,0,0"><TextBlock Text="Bu cihaza sahibim" Foreground="#9BAAB6" FontSize="11"/><Border x:Name="State" HorizontalAlignment="Right" Width="28" Height="28" CornerRadius="14" Background="#17242E"><TextBlock x:Name="Mark" Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border></Grid></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#102A2A"/><Setter TargetName="Card" Property="BorderBrush" Value="#51D9B5"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="State" Property="Background" Value="#51D9B5"/><Setter TargetName="Mark" Property="Text" Value="✓"/><Setter TargetName="Mark" Property="Foreground" Value="#07130F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#35AEEF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#087DC4"/><Setter Property="BorderBrush" Value="#28A9F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="NiiMotion'a hoş geldin" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Hangi hareket cihazlarına sahipsin?" FontSize="18" Margin="0,8,0,3"/><TextBlock Text="Yalnız seçtiklerin için profil ve kalibrasyon adımları gösterilecek. Bunu daha sonra değiştirebilirsin." Foreground="#94A1AD" FontSize="12"/></StackPanel>
  <Border Grid.Row="1" Margin="0,22,0,18" Padding="13,10" Background="#0B1924" BorderBrush="#234357" BorderThickness="1" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="/NiiRMotion.App;component/Assets/device-v3-quest3.png" Width="48" Height="42"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Meta Quest 3" FontWeight="SemiBold"/><TextBlock Text="Ana başlık · tüm profillerde kullanılır" Foreground="#7FA1B8" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="✓ DAHİL" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#55E6C1" FontSize="10" FontWeight="Bold"/></Grid></Border>
  <WrapPanel Grid.Row="2">
   <CheckBox x:Name="JoyConChoice" Style="{StaticResource DeviceChoice}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid><Image Source="/NiiRMotion.App;component/Assets/device-v3-joycon-left.png" Height="76" HorizontalAlignment="Left"/><Image Source="/NiiRMotion.App;component/Assets/device-v3-joycon-right.png" Height="76" HorizontalAlignment="Right"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="2× Joy-Con" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Uyluk sensörleri" Foreground="#8FA0AD" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></CheckBox>
   <CheckBox x:Name="PsMoveChoice" Style="{StaticResource DeviceChoice}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid><Image Source="/NiiRMotion.App;component/Assets/device-v3-psmove-left.png" Height="78" HorizontalAlignment="Left"/><Image Source="/NiiRMotion.App;component/Assets/device-v3-psmove-right.png" Height="78" HorizontalAlignment="Right"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="2× PS Move" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Baldır sensörleri" Foreground="#8FA0AD" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></CheckBox>
   <CheckBox x:Name="PhoneChoice" Style="{StaticResource DeviceChoice}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="/NiiRMotion.App;component/Assets/device-v3-phone.png" Height="80"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Android telefon" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Göğüs sensörü" Foreground="#8FA0AD" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></CheckBox>
   <CheckBox x:Name="BoardChoice" Style="{StaticResource DeviceChoice}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="/NiiRMotion.App;component/Assets/device-v3-board.png" Width="84"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Wii Balance Board" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Basınç ve denge" Foreground="#8FA0AD" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></CheckBox>
   <CheckBox x:Name="HandsChoice" Style="{StaticResource DeviceChoice}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="/NiiRMotion.App;component/Assets/device-v3-hands.png" Width="84"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="El takibi" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="İsteğe bağlı kontrol" Foreground="#8FA0AD" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></CheckBox>
  </WrapPanel>
  <Grid Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="Seçimine göre en uygun profiller performans ve kullanım kolaylığına göre sıralanacak." Foreground="#7F929F" FontSize="10" VerticalAlignment="Center"/><Button Content="DEVAM ET  →" HorizontalAlignment="Right" Click="SaveClick"/></Grid>
 </Grid>
</Window>
