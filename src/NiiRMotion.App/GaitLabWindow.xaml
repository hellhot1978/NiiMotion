<Window x:Class="NiiRMotion.App.GaitLabWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Yürüyüş Laboratuvarı" Width="920" Height="650" WindowStartupLocation="CenterOwner" Background="#050A12" Foreground="#F6F9FF" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F6F9FF"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#F6F9FF"/><Setter Property="Background" Value="#0D1928"/><Setter Property="BorderBrush" Value="#2A3B54"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#101722"/><Setter Property="Padding" Value="10,8"/></Style>
  </Window.Resources>
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="Joy-Con Laboratuvarı" FontSize="24" FontWeight="Bold"/><TextBlock Text="Yalnız sol ve sağ Joy-Con · VR çıkışı kapalı" Foreground="#7FA5D7" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" Padding="12,7" Background="#102443" CornerRadius="5" Margin="8,4,0,4"><TextBlock x:Name="LabState" Text="HAZIR" Foreground="#72E1C2" FontWeight="Bold"/></Border></Grid>
    <Grid Grid.Row="1" Margin="0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#080F19" BorderBrush="#233044" BorderThickness="1" CornerRadius="6"><Grid>
        <Canvas Width="360" Height="390" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse Width="72" Height="72" Canvas.Left="144" Canvas.Top="18" Fill="#D6A47C" Stroke="#5A769C" StrokeThickness="3"/>
          <Path Data="M145,52 C148,15 207,9 216,50 C198,35 166,32 145,52" Fill="#263B57"/>
          <Border Width="96" Height="132" Canvas.Left="132" Canvas.Top="87" Background="#315D91" BorderBrush="#74A8E6" BorderThickness="3" CornerRadius="25,25,16,16"/>
          <Line X1="139" Y1="112" X2="88" Y2="205" Stroke="#D6A47C" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Line X1="221" Y1="112" X2="272" Y2="205" Stroke="#D6A47C" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Line x:Name="LeftThigh" X1="155" Y1="211" X2="143" Y2="282" Stroke="#29476F" StrokeThickness="25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Line x:Name="LeftShin" X1="143" Y1="282" X2="125" Y2="348" Stroke="#355D91" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Line x:Name="RightThigh" X1="205" Y1="211" X2="217" Y2="282" Stroke="#29476F" StrokeThickness="25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Line x:Name="RightShin" X1="217" Y1="282" X2="235" Y2="348" Stroke="#355D91" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Rectangle x:Name="LeftShoe" Width="68" Height="19" Canvas.Left="91" Canvas.Top="342" RadiusX="9" Fill="#DCE7F4"/>
          <Rectangle x:Name="RightShoe" Width="68" Height="19" Canvas.Left="215" Canvas.Top="342" RadiusX="9" Fill="#DCE7F4"/>
          <TextBlock Text="SOL" Foreground="#4B8EFF" FontWeight="Bold" Canvas.Left="52" Canvas.Top="360"/><TextBlock Text="SAĞ" Foreground="#61D9B5" FontWeight="Bold" Canvas.Left="270" Canvas.Top="360"/>
        </Canvas>
      </Grid></Border>
      <StackPanel Grid.Column="2">
        <Border Background="#080F19" BorderBrush="#233044" BorderThickness="1" CornerRadius="6" Padding="11"><StackPanel>
          <TextBlock Text="CANLI HAREKET" Foreground="#75A6FF" FontSize="11" FontWeight="Bold"/>
          <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Joy-Con çifti" Foreground="#8FA4BF" FontSize="10"/><TextBlock x:Name="FusionPreviewText" Grid.Column="1" Text="HIZ 0.00" Foreground="#72E1C2" FontSize="11" FontWeight="Bold"/></Grid>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Sol bacak" FontSize="11"/><TextBlock x:Name="LeftValue" Text="0" FontSize="21"/><ProgressBar x:Name="LeftBar" Maximum="250" Height="5" Foreground="#4B8EFF"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Sağ bacak" FontSize="11"/><TextBlock x:Name="RightValue" Text="0" FontSize="21"/><ProgressBar x:Name="RightBar" Maximum="250" Height="5" Foreground="#61D9B5"/></StackPanel></Grid>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ADIM" Foreground="#75A6FF" FontSize="9"/><TextBlock x:Name="StepValue" Text="0" FontSize="24"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SÜRE" Foreground="#75A6FF" FontSize="9"/><TextBlock x:Name="TimeValue" Text="00:00" FontSize="24"/></StackPanel></Grid>
        </StackPanel></Border>
        <Border Background="#080F19" BorderBrush="#233044" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,8,0,0"><StackPanel><TextBlock Text="KISA SENSÖR KAYDI" Foreground="#75A6FF" FontSize="10" FontWeight="Bold"/><TextBlock Text="Joy-Con hareketini tek başına doğrula" Foreground="#8FA4BF" FontSize="10" Margin="0,3,0,5"/><ComboBox x:Name="LabelSelector" SelectedIndex="2" Margin="0,7,0,4"><ComboBoxItem Tag="stand">Ayakta sabit</ComboBoxItem><ComboBoxItem Tag="slow">Yavaş yürüyüş</ComboBoxItem><ComboBoxItem Tag="natural">Doğal yürüyüş</ComboBoxItem><ComboBoxItem Tag="fast">Hızlı yürüyüş</ComboBoxItem><ComboBoxItem Tag="stop">Yürü ve dur</ComboBoxItem></ComboBox><Border Background="#101E31" CornerRadius="5" Padding="7" Margin="0,2"><StackPanel><TextBlock x:Name="InstructionText" Text="Yönerge burada görünecek" Foreground="#72E1C2" FontSize="16" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="InstructionCounter" Text="" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" TextAlignment="Center"/></StackPanel></Border><Button x:Name="RecordButton" Content="●  KISA KAYDI BAŞLAT" Background="#2F6CDF" Padding="10,7" Click="RecordClick"/><TextBlock x:Name="RecordInfo" Text="Yalnız Joy-Con verisi kaydedilir." Foreground="#8FA4BF" FontSize="10" TextWrapping="Wrap" Margin="2,3"/></StackPanel></Border>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HintText" Text="Joy-Con'ları bacaklarına bağladıktan sonra Canlı Test'i başlat." Foreground="#AFC0D8" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="LiveButton" Content="▶  CANLI TEST" Click="LiveClick"/><Button Content="KAPAT" Click="CloseClick"/></StackPanel></Grid>
  </Grid>
</Window>
