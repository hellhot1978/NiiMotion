<Window x:Class="NiiRMotion.App.PsMoveLabWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · PS Move Kalibrasyonu" Width="940" Height="650" WindowStartupLocation="CenterOwner" Background="#050A12" Foreground="#F6F9FF" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable" ResizeMode="NoResize">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F6F9FF"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F6F9FF"/><Setter Property="Background" Value="#10243A"/><Setter Property="BorderBrush" Value="#31516D"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="PS Move Bacak Kalibrasyonu" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Move: diz altı / baldır · Joy-Con: kalça–diz arası / uyluk · VR çıkışı kapalı" Foreground="#75A6C8" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#0D2A25" BorderBrush="#226A59" BorderThickness="1" CornerRadius="6" Padding="13,8"><TextBlock x:Name="StateText" Text="HAZIR" Foreground="#63DFBB" FontWeight="Bold"/></Border></Grid>
  <Grid Grid.Row="1" Margin="0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#0A131D" BorderBrush="#263946" BorderThickness="1" CornerRadius="9" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="DOĞRU YERLEŞİM" Foreground="#35B8F5" FontSize="10" FontWeight="Bold"/><TextBlock Text="Her iki Move aynı yönde olmalı" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock Text="Baldırın dış/ön tarafına, dizin hemen altına sabitle. Küre yukarı, düğmeler dışarı/öne baksın. Bandı dolaşımı bozmayacak kadar sıkı tut." Foreground="#AFC0CC" TextWrapping="Wrap"/></StackPanel>
    <Canvas Grid.Row="1" Width="330" Height="320" HorizontalAlignment="Center" Margin="0,12"><Ellipse Width="62" Height="62" Canvas.Left="134" Canvas.Top="4" Fill="#D6A47C"/><Border Width="90" Height="110" Canvas.Left="120" Canvas.Top="70" Background="#315D91" CornerRadius="22"/><Line X1="142" Y1="170" X2="125" Y2="244" Stroke="#315D91" StrokeThickness="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line X1="188" Y1="170" X2="205" Y2="244" Stroke="#315D91" StrokeThickness="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line X1="125" Y1="244" X2="112" Y2="309" Stroke="#436C9C" StrokeThickness="21" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line X1="205" Y1="244" X2="218" Y2="309" Stroke="#436C9C" StrokeThickness="21" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Ellipse Width="18" Height="18" Canvas.Left="102" Canvas.Top="248" Fill="#F0445D" Stroke="#FF9AAA" StrokeThickness="2"/><Ellipse Width="18" Height="18" Canvas.Left="210" Canvas.Top="248" Fill="#268CFF" Stroke="#8FC5FF" StrokeThickness="2"/><TextBlock Text="SOL" Canvas.Left="58" Canvas.Top="250" Foreground="#F87186" FontWeight="Bold"/><TextBlock Text="SAĞ" Canvas.Left="246" Canvas.Top="250" Foreground="#5BA7FF" FontWeight="Bold"/></Canvas>
    <TextBlock Grid.Row="2" Text="Sol Move kırmızı · Sağ Move mavi" HorizontalAlignment="Center" Foreground="#C9D5DE"/>
   </Grid></Border>
   <Border Grid.Column="2" Background="#0A131D" BorderBrush="#263946" BorderThickness="1" CornerRadius="9" Padding="20"><StackPanel>
    <TextBlock Text="YÖNLENDİRMELİ KALİBRASYON" Foreground="#35B8F5" FontSize="10" FontWeight="Bold"/>
    <TextBlock x:Name="InstructionText" Text="Move’ları taktıktan sonra bağlantıyı doğrula" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4"/>
    <TextBlock x:Name="DetailText" Text="İlk adımda sensör akışı ve renkler kontrol edilir." Foreground="#AFC0CC" TextWrapping="Wrap" MinHeight="42"/>
    <Border Background="#101E2B" CornerRadius="7" Padding="14" Margin="0,18,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SOL BALDIR" Foreground="#F87186" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LeftValue" Text="—" FontSize="23"/><ProgressBar x:Name="LeftBar" Maximum="4" Height="6" Foreground="#F0445D"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="SAĞ BALDIR" Foreground="#5BA7FF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RightValue" Text="—" FontSize="23"/><ProgressBar x:Name="RightBar" Maximum="4" Height="6" Foreground="#268CFF"/></StackPanel></Grid></Border>
    <Border Background="#0D1928" BorderBrush="#263F55" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="CountdownText" Text="1 · BAĞLANTI KONTROLÜ" Foreground="#72E1C2" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="ProgressText" Text="Henüz başlatılmadı" Foreground="#8FA4BF" Margin="0,5,0,0"/></StackPanel></Border>
    <Button x:Name="ActionButton" Content="▶  MOVE’LARI DOĞRULA" Background="#168ED1" BorderBrush="#43B7F4" Click="ActionClick"/>
    <TextBlock Text="Kalibrasyon sırasında oyun hareketi üretilmez." Foreground="#7F93A2" FontSize="10" TextAlignment="Center" Margin="0,10,0,0"/>
   </StackPanel></Border>
  </Grid>
  <Grid Grid.Row="2"><TextBlock x:Name="FooterText" Text="Sırayla: bağlantı → 5 sn sabit duruş → kontrollü bacak kaldırma" Foreground="#8FA4BF" VerticalAlignment="Center"/><Button Content="KAPAT" HorizontalAlignment="Right" Click="CloseClick"/></Grid>
 </Grid>
</Window>
