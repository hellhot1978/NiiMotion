<Window x:Class="NiiRMotion.App.DiagnosticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Sistem Tanılama" Icon="/NiiRMotion.App;component/Assets/niirmotion.ico" Width="760" Height="560" WindowStartupLocation="CenterOwner" Background="#060A0F" Foreground="#F4F7FA" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable" ResizeMode="NoResize">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Sistem Tanılama" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Bağlantı sorunlarını anlaşılır biçimde açıklar · oyun hareketi göndermez" Foreground="#8FA1AD" Margin="0,5,0,18"/></StackPanel>
  <ListBox x:Name="Findings" Grid.Row="1" Background="#0B141D" BorderBrush="#2B4050" Padding="10" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Background="#0E1922" BorderBrush="#29404E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,9"><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Explanation}" Foreground="#AAB8C2" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Action}" Foreground="#45BDF4" TextWrapping="Wrap" Margin="0,7,0,0" FontWeight="SemiBold"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Tanı paketi ham hareket verisi içermez." Foreground="#72E1C2" VerticalAlignment="Center"/><Button Grid.Column="1" Content="GİZLİLİK KORUMALI TANI PAKETİ" Padding="17,10" Click="ExportClick"/><Button Grid.Column="3" Content="KAPAT" Padding="17,10" Click="CloseClick"/></Grid>
 </Grid>
</Window>
