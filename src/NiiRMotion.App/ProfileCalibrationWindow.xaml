<Window x:Class="NiiRMotion.App.ProfileCalibrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Yürüyüş Kalibrasyonu" Icon="/NiiRMotion.App;component/Assets/niirmotion.ico" Width="880" Height="560" WindowStartupLocation="CenterOwner" Background="#060A0F" Foreground="#F4F7FA" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable" ResizeMode="NoResize">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F7FA"/></Style><Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#101A24"/><Setter Property="BorderBrush" Value="#2B4050"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></Style.Triggers></Style></Window.Resources>
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Birlikte çalışma kalibrasyonu" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ProfileText" Text="Aktif profil" Foreground="#55DDB8" FontSize="12" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#10261F" BorderBrush="#285B4D" BorderThickness="1" CornerRadius="6" Padding="13,8"><TextBlock Text="VR ÇIKIŞI KAPALI" Foreground="#60DCB7" FontSize="9" FontWeight="Bold"/></Border></Grid>
  <Grid Grid.Row="1" Margin="0,24,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#0D151D" BorderBrush="#263744" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="BU KAYIT NE YAPAR?" Foreground="#35B8F5" FontSize="9" FontWeight="Bold"/><TextBlock Text="Sensörleri aynı zaman çizgisinde ölçer" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,7"/><TextBlock Text="Tekil cihaz kalibrasyonlarını değiştirmez. Seçili profildeki sensörlerin ritim, hız, başlangıç, duruş ve yanlış hareket uyumunu ayrı bir model olarak kaydeder." Foreground="#92A2AE" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="SensorText" Foreground="#C8D4DC" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Background="#0D151D" BorderBrush="#263744" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="3 FAZ · 6 DAKİKA" Foreground="#35B8F5" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="InstructionText" Text="Faz 1 ile başla." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,16"/><Button x:Name="Phase1" Tag="1" Click="PhaseClick" Margin="0,0,0,10"/><Button x:Name="Phase2" Tag="2" Click="PhaseClick" Margin="0,0,0,10"/><Button x:Name="Phase3" Tag="3" Click="PhaseClick"/><ProgressBar x:Name="Progress" Minimum="0" Maximum="120" Height="6" Margin="0,23,0,0" Foreground="#20A5ED" Background="#182A36"/><TextBlock x:Name="Timer" Text="00:00 / 02:00" HorizontalAlignment="Right" Foreground="#7E94A3" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
  </Grid>
  <Grid Grid.Row="2"><TextBlock Text="Kesilen veya yetersiz veri üreten faz tamamlanmış sayılmaz." Foreground="#7D909D" FontSize="10" VerticalAlignment="Center"/><Button Content="KAPAT" HorizontalAlignment="Right" Click="CloseClick"/></Grid>
 </Grid>
</Window>
