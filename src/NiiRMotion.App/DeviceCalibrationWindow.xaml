<Window x:Class="NiiRMotion.App.DeviceCalibrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Temel Kalibrasyon" Icon="/NiiRMotion.App;component/Assets/niirmotion.ico" Width="900" Height="620" WindowStartupLocation="CenterOwner" Background="#060A0F" Foreground="#F4F7FA" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable" ResizeMode="NoResize">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F7FA"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#101A24"/><Setter Property="BorderBrush" Value="#2B4050"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#0A1118"/><Setter Property="Foreground" Value="#65737D"/><Setter Property="BorderBrush" Value="#1C2933"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TitleText" Text="Cihaz kalibrasyonu" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Bağlantı ve üç temel kayıt" Foreground="#8EA1AF" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#10261F" BorderBrush="#285B4D" BorderThickness="1" CornerRadius="6" Padding="13,8"><TextBlock Text="VR ÇIKIŞI KAPALI" Foreground="#60DCB7" FontSize="9" FontWeight="Bold"/></Border></Grid>
  <Grid Grid.Row="1" Margin="0,24,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#0D151D" BorderBrush="#263744" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel><Image x:Name="DeviceImage" Height="96" Stretch="Uniform"/><TextBlock x:Name="DeviceName" Text="Cihaz" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,8"/><Border Background="#09131B" BorderBrush="#233642" BorderThickness="1" CornerRadius="6" Padding="10,8"><StackPanel><TextBlock Text="GEREKLİ YAZILIM" Foreground="#35B8F5" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="SoftwareHelpText" Text="Yazılım bilgisi" Foreground="#D6E1E7" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border><TextBlock Text="KURULUM VE YERLEŞİM" Foreground="#718B9B" FontSize="9" FontWeight="Bold" Margin="0,10,0,0"/><TextBlock x:Name="SetupHelpText" Text="Bağlantı yönergeleri" Foreground="#9FB1BD" FontSize="10" TextAlignment="Left" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="ConnectionText" Text="Bağlantı henüz doğrulanmadı" Foreground="#F1C566" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/><Button x:Name="ConnectionButton" Content="BAĞLANTIYI KONTROL ET" Margin="0,10,0,0" Click="ConnectionClick"/><Button x:Name="RePairButton" Content="MOVE'LARI YENİDEN EŞLEŞTİR" Visibility="Collapsed" Margin="0,7,0,0" Padding="10,8" FontSize="10" Click="RePairClick"/></StackPanel></Border>
   <Border Grid.Column="2" Background="#0D151D" BorderBrush="#263744" BorderThickness="1" CornerRadius="9" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="TEMEL KALİBRASYON" Foreground="#35B8F5" FontSize="9" FontWeight="Bold"/><TextBlock Text="3 faz · her biri 5 dakika" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock Text="Tamamlanan bir faz hatalıysa yanındaki yeniden çek düğmesini kullanabilirsin." Foreground="#8FA0AD" FontSize="11" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1" Margin="0,20,0,0"><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Button x:Name="Phase1Button" Tag="1" Click="PhaseClick" HorizontalContentAlignment="Stretch"/><Button x:Name="Phase1ResetButton" Grid.Column="1" Tag="1" Content="↻" ToolTip="Faz 1'i sil ve yeniden çek" Margin="6,0,0,0" Padding="8" Click="ResetPhaseClick"/></Grid><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Button x:Name="Phase2Button" Tag="2" Click="PhaseClick" HorizontalContentAlignment="Stretch"/><Button x:Name="Phase2ResetButton" Grid.Column="1" Tag="2" Content="↻" ToolTip="Faz 2'yi sil ve yeniden çek" Margin="6,0,0,0" Padding="8" Click="ResetPhaseClick"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Button x:Name="Phase3Button" Tag="3" Click="PhaseClick" HorizontalContentAlignment="Stretch"/><Button x:Name="Phase3ResetButton" Grid.Column="1" Tag="3" Content="↻" ToolTip="Faz 3'ü sil ve yeniden çek" Margin="6,0,0,0" Padding="8" Click="ResetPhaseClick"/></Grid></StackPanel><Border Grid.Row="2" Background="#08121A" BorderBrush="#203441" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,18,0,0"><StackPanel><TextBlock x:Name="InstructionText" Text="Önce cihaz bağlantısını doğrula." TextWrapping="Wrap" Foreground="#B9C7D0"/><Button x:Name="RepairSegmentButton" Content="↻ SORUNLU BÖLÜMÜ YENİDEN KAYDET" Visibility="Collapsed" Margin="0,10,0,0" Click="RepairSegmentClick"/><ProgressBar x:Name="PhaseProgress" Minimum="0" Maximum="300" Height="6" Margin="0,12,0,0" Foreground="#20A5ED" Background="#182A36"/><TextBlock x:Name="TimerText" Text="00:00 / 05:00" HorizontalAlignment="Right" Foreground="#7E94A3" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></Grid></Border>
  </Grid>
  <Grid Grid.Row="2"><TextBlock Text="Temel kalibrasyon yalnız cihazı kullanıma hazırlar. Ek eğitim kayıtları Kalibrasyon Merkezi'ndeki “Modeli geliştir” bölümündedir." Foreground="#7D909D" FontSize="10" VerticalAlignment="Center"/><Button Content="KAPAT" HorizontalAlignment="Right" Click="CloseClick"/></Grid>
 </Grid>
</Window>
