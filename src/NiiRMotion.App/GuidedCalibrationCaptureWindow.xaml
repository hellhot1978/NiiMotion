<Window x:Class="NiiRMotion.App.GuidedCalibrationCaptureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Yönlendirmeli Kalibrasyon" Icon="/NiiRMotion.App;component/Assets/niirmotion.ico" Width="980" Height="680" WindowStartupLocation="CenterOwner" Background="#060A0F" Foreground="#F4F7FA" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable" ResizeMode="NoResize">
 <Window.Resources><Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#11202B"/><Setter Property="BorderBrush" Value="#315064"/><Setter Property="Padding" Value="20,12"/><Setter Property="FontWeight" Value="SemiBold"/></Style></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="HeaderText" Text="Faz" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Aktif süre sayılır · duraklatıldığında veri kaydı ve sayaç birlikte durur" Foreground="#8FA4B1" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#10271F" BorderBrush="#2D6956" BorderThickness="1" CornerRadius="7" Padding="14,9"><TextBlock x:Name="RecordStateText" Text="● KAYIT HAZIRLANIYOR" Foreground="#62E0BC" FontWeight="Bold"/></Border></Grid>
  <Grid Grid.Row="1" Margin="0,22,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#0D1720" BorderBrush="#29404D" BorderThickness="1" CornerRadius="10"><Canvas Width="400" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse x:Name="Head" Canvas.Left="165" Canvas.Top="35" Width="70" Height="70" Fill="#D8A477"/><Border x:Name="Body" Canvas.Left="140" Canvas.Top="112" Width="120" Height="145" Background="#35679B" CornerRadius="35"/><Line x:Name="LeftArm" X1="150" Y1="130" X2="80" Y2="245" Stroke="#D8A477" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line x:Name="RightArm" X1="250" Y1="130" X2="320" Y2="245" Stroke="#D8A477" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line x:Name="LeftLeg" X1="170" Y1="245" X2="125" Y2="405" Stroke="#315B8D" StrokeThickness="28" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line x:Name="RightLeg" X1="230" Y1="245" X2="275" Y2="405" Stroke="#315B8D" StrokeThickness="28" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock x:Name="PoseLabel" Canvas.Left="0" Canvas.Top="420" Width="400" Text="SABİT DUR" TextAlignment="Center" Foreground="#55DDB8" FontSize="16" FontWeight="Bold"/></Canvas></Border>
   <Border Grid.Column="2" Background="#0D1720" BorderBrush="#29404D" BorderThickness="1" CornerRadius="10" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="ŞİMDİ YAP" Foreground="#37B8F3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InstructionText" Text="Hazırlan" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,7"/><TextBlock x:Name="InstructionDetail" Foreground="#A9BBC6" FontSize="13" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="BU HAREKETİN KALAN SÜRESİ" Foreground="#708895" FontSize="9"/><TextBlock x:Name="StepRemainingText" Text="00:00" FontSize="45" FontWeight="Light"/><TextBlock Text="SONRAKİ HAREKET" Foreground="#708895" FontSize="9" Margin="0,20,0,5"/><TextBlock x:Name="NextStepText" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="2"><ProgressBar x:Name="OverallProgress" Minimum="0" Maximum="300" Height="8" Foreground="#159BE8" Background="#1A2A35"/><Grid Margin="0,7,0,0"><TextBlock x:Name="ElapsedText" Text="00:00"/><TextBlock Text="05:00" HorizontalAlignment="Right"/></Grid></StackPanel></Grid></Border>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Sensör akışı başlatılıyor…" Foreground="#8FA4B1" VerticalAlignment="Center"/><Button x:Name="PauseButton" Grid.Column="1" Content="Ⅱ  DURAKLAT" Click="PauseClick"/><Button x:Name="CancelButton" Grid.Column="3" Content="İPTAL" Click="CancelClick"/></Grid>
 </Grid>
</Window>
