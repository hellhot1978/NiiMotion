<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NiiRMotion.Core\NiiRMotion.Core.csproj" />
    <ProjectReference Include="..\NiiRMotion.Infrastructure\NiiRMotion.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\niirmotion.ico" />
    <Resource Include="Assets\niirmotion-icon.png" />
    <Resource Include="Assets\Fonts\InterVariable.ttf" />
    <Content Include="Assets\Fonts\Inter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\device-*" />
    <EmbeddedResource Include="Assets\Localization\en.generated.json" />
    <Content Include="..\..\native\openvr-driver\dist\driver.vrdrivermanifest" Link="OpenVRDriver\driver.vrdrivermanifest" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\openvr-driver\dist\bin\win64\driver_niirmotion.dll" Link="OpenVRDriver\bin\win64\driver_niirmotion.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\openvr-driver\dist\resources\input\niirmotion_profile.json" Link="OpenVRDriver\resources\input\niirmotion_profile.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\openvr-driver\dist\resources\input\default_bindings\*.json" Link="OpenVRDriver\resources\input\default_bindings\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\openxr-layer\dist\niirmotion_openxr.json" Link="OpenXRLayer\niirmotion_openxr.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\openxr-layer\dist\bin\win64\niirmotion_openxr.dll" Link="OpenXRLayer\bin\win64\niirmotion_openxr.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\vr-overlay\dist\NiiMotion.VrOverlay.exe" Link="VrOverlay\NiiMotion.VrOverlay.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\vr-overlay\dist\openvr_api.dll" Link="VrOverlay\openvr_api.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\vr-overlay\niirmotion.vrmanifest" Link="VrOverlay\niirmotion.vrmanifest" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\models\*.json" Link="Models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\calibration\*.json" Link="Calibration\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\psmoveapi\4.0.12\psmove.exe" Link="Tools\PSMoveAPI\4.0.12\psmove.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\psmoveapi\4.0.12\psmoveapi.dll" Link="Tools\PSMoveAPI\4.0.12\psmoveapi.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\psmoveapi\4.0.12\COPYING" Link="Tools\PSMoveAPI\4.0.12\COPYING" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\niirmotion-icon.png" Link="VrOverlay\dashboard-icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\niirmotion.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>0.6.0</Version>
  </PropertyGroup>

</Project>
