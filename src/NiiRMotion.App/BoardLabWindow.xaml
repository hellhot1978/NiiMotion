<Window x:Class="NiiRMotion.App.BoardLabWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NiiMotion · Balance Board Laboratuvarı" Width="940" Height="680" WindowStartupLocation="CenterOwner" Background="#050A12" Foreground="#F6F9FF" FontFamily="/NiiRMotion.App;component/Assets/Fonts/#Inter Variable">
  <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F6F9FF"/></Style><Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#0D1928"/><Setter Property="BorderBrush" Value="#2A3B54"/><Setter Property="Padding" Value="15,11"/><Setter Property="FontWeight" Value="SemiBold"/></Style></Window.Resources>
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="Balance Board Laboratuvarı" FontSize="25" FontWeight="Bold"/><TextBlock Text="Görsel yönlendirmeli kişisel basınç ve yürüyüş kalibrasyonu · VR çıkışı yok" Foreground="#7FA5D7" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" Padding="13,8" Background="#102443" CornerRadius="6"><TextBlock x:Name="StateText" Text="HAZIR" Foreground="#72E1C2" FontWeight="Bold"/></Border></Grid>
    <Grid Grid.Row="1" Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#080F19" BorderBrush="#233044" BorderThickness="1" CornerRadius="8"><Canvas Width="410" Height="470" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse Width="76" Height="76" Canvas.Left="167" Canvas.Top="20" Fill="#D6A47C" Stroke="#5A769C" StrokeThickness="3"/><Path Data="M168,54 C170,12 238,8 243,52 C225,35 190,32 168,54" Fill="#263B57"/>
        <Border x:Name="Torso" Width="104" Height="145" Canvas.Left="153" Canvas.Top="92" Background="#315D91" BorderBrush="#74A8E6" BorderThickness="3" CornerRadius="28,28,18,18" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><TranslateTransform x:Name="BodyShift"/></Border.RenderTransform></Border>
        <Line X1="160" Y1="118" X2="103" Y2="226" Stroke="#D6A47C" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line X1="250" Y1="118" X2="307" Y2="226" Stroke="#D6A47C" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Line x:Name="BoardLeftLeg" X1="180" Y1="225" X2="151" Y2="358" Stroke="#29476F" StrokeThickness="27" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line x:Name="BoardRightLeg" X1="230" Y1="225" X2="259" Y2="358" Stroke="#29476F" StrokeThickness="27" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Rectangle Width="82" Height="22" Canvas.Left="96" Canvas.Top="348" RadiusX="10" Fill="#DCE7F4"/><Rectangle Width="82" Height="22" Canvas.Left="232" Canvas.Top="348" RadiusX="10" Fill="#DCE7F4"/>
        <Border Width="310" Height="58" Canvas.Left="50" Canvas.Top="374" Background="#DDE5EA" BorderBrush="#5B7180" BorderThickness="4" CornerRadius="20"><Grid><Ellipse Width="28" Height="28" HorizontalAlignment="Left" Margin="28,0,0,0" Fill="#57C9BE"/><Ellipse Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,28,0" Fill="#4B8EFF"/><Ellipse x:Name="PressureDot" Width="18" Height="18" Fill="#F05B3D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
        <TextBlock Text="SOL" Canvas.Left="73" Canvas.Top="442" Foreground="#57C9BE" FontWeight="Bold"/><TextBlock Text="SAĞ" Canvas.Left="302" Canvas.Top="442" Foreground="#4B8EFF" FontWeight="Bold"/>
      </Canvas></Border>
      <StackPanel Grid.Column="2">
        <Border Background="#080F19" BorderBrush="#233044" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="ÖLÇÜM TÜRÜ" Foreground="#75A6FF" FontSize="10" FontWeight="Bold"/><ComboBox x:Name="StageSelector" SelectedIndex="0" Padding="10,8" Margin="0,7,0,13"><ComboBoxItem Tag="full-calibration">★ 2 dakikalık tam kalibrasyon</ComboBoxItem><ComboBoxItem Tag="standing-center">Ortada sabit duruş</ComboBoxItem><ComboBoxItem Tag="slow-march">Yavaş yerinde yürüyüş</ComboBoxItem><ComboBoxItem Tag="natural-march">Doğal yerinde yürüyüş</ComboBoxItem><ComboBoxItem Tag="fast-march">Hızlı yerinde yürüyüş</ComboBoxItem><ComboBoxItem Tag="turning">Sağa-sola dönüş</ComboBoxItem><ComboBoxItem Tag="stop-exit">Yürü → dur → karttan in</ComboBoxItem></ComboBox>
          <Border Background="#102036" CornerRadius="7" Padding="15"><StackPanel><TextBlock x:Name="InstructionText" Text="Kart boşken Başlat'a bas" Foreground="#72E1C2" FontSize="19" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="CounterText" Text="" FontSize="40" FontWeight="Bold" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
          <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TOPLAM YÜK" Foreground="#75A6FF" FontSize="9"/><TextBlock x:Name="WeightText" Text="0.0 kg" FontSize="24"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="GEÇİŞ" Foreground="#75A6FF" FontSize="9"/><TextBlock x:Name="TransitionText" Text="0" FontSize="24"/></StackPanel></Grid>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SAĞ / SOL" Foreground="#75A6FF" FontSize="9"/><TextBlock x:Name="CopXText" Text="0.00" FontSize="19"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ÖN / ARKA" Foreground="#75A6FF" FontSize="9"/><TextBlock x:Name="CopYText" Text="0.00" FontSize="19"/></StackPanel></Grid>
          <Button x:Name="StartButton" Content="▶  ÖLÇÜMÜ BAŞLAT" Background="#2F6CDF" BorderBrush="#70A4FF" Margin="0,17,0,0" Click="StartClick"/><TextBlock x:Name="ResultText" Text="Kart açılışta otomatik olarak sıfırlanır." Foreground="#9FB0C5" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2"><TextBlock Text="Her ölçümden önce kart boş olmalı. İlk sesten sonra ekrandaki hareketi uygula." Foreground="#AFC0D8" VerticalAlignment="Center"/><Button Content="KAPAT" HorizontalAlignment="Right" Click="CloseClick"/></Grid>
  </Grid>
</Window>
